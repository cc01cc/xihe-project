# ============================================================
# XH dev 环境基线（入库，仅占位值；真实密钥放 .env.local，gitignored）
# 用法：mise run dev:host（原生）或 docker compose（env_file 链），
#       模块内 loader 自动按 .env → .env.dev → .env.local 加载
# ============================================================

# ── 端口段（栈槽位基准；本文件是 stack-1 基线与模块缺省值） ──
# PLAN-0533：槽位表见 one/plans/PLAN-0533-XH-parallel-host-stacks/spec/stack-contract.md
#   stack-1 12630..12634（本段字面值，勿改）
#   stack-2 12640.. / stack-3 12650.. / stack-4 12660..
#   stack-5 12700.. / stack-6 12710.. / stack-7 12730.. / stack-8 12740..（跳过已占段位）
# 启动器（mise run dev:host / dev:stack -- --stack N）把派生值注入进程 env；
# 模块仍只读 XIHE_*_PORT（不读 XIHE_STACK_ID）。XIHE_STACK_ID 缺省 stack-1，非法值 fail-fast。
XIHE_UI_PORT=12630
XIHE_CP_PORT=12631
XIHE_AGENT_PORT=12632
XIHE_RUNTIME_PORT=12633
XIHE_PG_PORT=12634

# ── 服务端点与绑定（stack≥2 时由启动器整体替换为对应槽位） ──
XIHE_CP_URL=http://localhost:12631
XIHE_CP_BASE_URL=http://localhost:12631
XIHE_AGENT_HOST=0.0.0.0
XIHE_AGENT_URL=http://localhost:12632/internal/v1/agent/chat
XIHE_RUNTIME_HOST=0.0.0.0
XIHE_RUNTIME_URL=http://localhost:12633

# ── 数据库（docker compose 本地 PG；库名统一 xihe_<n>，stack-1 → xihe_1） ──
XIHE_CP_DATASOURCE_URL=jdbc:postgresql://localhost:12634/xihe_1
XIHE_PG_DSN=postgresql+psycopg://xihe:@localhost:12634/xihe_1
XIHE_CP_H2_CONSOLE=true

# ── 服务间 token（dev 占位；生产必须覆盖，fail-fast 校验会拒绝 prod 下使用） ──
XIHE_CP_API_TOKEN=dev-token-not-secure
XIHE_AGENT_API_TOKEN=dev-token-not-secure

# ── 安全（dev 宽松；生产见 .env.prod） ──
XIHE_CP_JWT_SECRET=dev-jwt-secret-key-do-not-use-in-production-please-change
XIHE_CP_OAUTH_ALLOW_DEV_KEY=true
XIHE_CP_PROVIDER_CREDENTIALS_ALLOW_DEV_KEY=true
XIHE_CP_CREDENTIALS_ALLOW_DEV_KEY=true
# XIHE_CP_OAUTH_ENCRYPTION_KEY=            # dev 留空走 dev key
# XIHE_CP_PROVIDER_CREDENTIALS_KEY=        # dev 留空走 dev key
# XIHE_CP_CREDENTIALS_KEY=                 # dev 留空走 dev key（或 KEY_RING=JSON 多版本环）
# XIHE_CP_CREDENTIALS_KEY_RING=            # 可选；JSON {version: base64 key}，current=CURRENT_VERSION（默认 v1）
# XIHE_CP_CREDENTIALS_FINGERPRINT_KEY=     # dev 留空走固定 dev 指纹 key（WARN；不得用于真实凭据）

# ── 工作区物化 ──
XIHE_WORKSPACE_HOST_ROOT=../../.xihe-workspaces
XIHE_WORKSPACE_IMAGE=xihe/workspace:latest
# XIHE_WORKSPACE=                 # 清单模式（多工作区）
# XIHE_SINGLE_WORKSPACE_MODE=false

# ── 沙盒容器资源（env 部署权威；缺省 = 512MB / 2 CPU / 100 pids，重启 Runtime 生效） ──
# XIHE_SANDBOX_MEMORY_MB=512
# XIHE_SANDBOX_CPUS=2
# XIHE_SANDBOX_PIDS_LIMIT=100

# ── 远程 MCP（dev 允许本地不安全端点） ──
XIHE_REMOTE_MCP_ALLOW_INSECURE_LOCAL=true
# XIHE_REMOTE_MCP_ALLOWED_HOSTS=

# ── 日志级别（dev 可调） ──
# XIHE_LOG_LEVEL_CP=INFO
# XIHE_LOG_LEVEL_AGENT=debug
# XIHE_LOG_LEVEL_RUNTIME=debug

# ── Provider 离线兜底（真实密钥禁止入库：放 .env.local 或部署注入） ──
# XIHE_XIAOMI_API_KEY=            # 离线兜底（常规走 provider_connections 租约，决策 #40）
# XIHE_DEEPSEEK_API_KEY=
# XIHE_OPENAI_API_KEY=
# DASHSCOPE_API_KEY=              # litellm dashscope provider 直读的系统 env
