# ============================================================
# XH base 环境（跨环境共享，入库）
# 加载顺序：.env → .env.$XIHE_ENV → .env.local（后加载覆盖先加载；
# 已存在的系统 env 永不被文件覆盖）
# 引导变量 XIHE_ENV / XIHE_LOAD_DOTENV / XIHE_ENV_FILE 由启动命令或
# 系统 env 提供，不写在本文件（见 spec/config-env-target §1.2）
# ============================================================

# ── 日志（共享） ──
XIHE_LOG_DIR=logs
XIHE_LOG_LEVEL=info                 # 框架级兜底；各模块可用 XIHE_LOG_LEVEL_CP/_AGENT/_RUNTIME 覆盖
# XIHE_RUNTIME_LOG_FILTER=          # tracing filter 表达式（默认空）

# ── CP 数据库驱动与 JWT 有效期（跨环境不变） ──
XIHE_CP_DATASOURCE_DRIVER=org.postgresql.Driver
XIHE_CP_DATASOURCE_USERNAME=xihe
XIHE_CP_JPA_DIALECT=org.hibernate.dialect.PostgreSQLDialect
XIHE_CP_JWT_ACCESS_VALIDITY=900
XIHE_CP_JWT_REFRESH_VALIDITY=604800

# ── 附件策略 ──
XIHE_ATTACHMENTS_ALLOWED_EXTENSIONS=png,jpg,jpeg,gif,webp,svg,bmp,pdf,doc,docx,txt,md,json,csv,xls,xlsx,ppt,pptx,mp3,wav,m4a,ogg,flac,aac,mp4,webm,mov,avi,mkv
XIHE_ATTACHMENTS_ORPHAN_RETENTION_HOURS=24
XIHE_ATTACHMENTS_ORPHAN_CLEANUP_INTERVAL_MS=3600000

# ── 审计与通道 ──
XIHE_CP_AUDIT_LOG_TO_CONSOLE=true
XIHE_CHANNEL_ENABLED=false
XIHE_CHANNEL_HEARTBEAT_TIMEOUT_SECONDS=90

# ── 向量模型（default 域，DB embedding 域优先；此处由 env overlay 锁定为部署权威） ──
XIHE_EMBEDDING_MODEL=text-embedding-3-small
