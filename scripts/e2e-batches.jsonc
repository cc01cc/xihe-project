{
  // XH host E2E batch manifest (PLAN-0375 R4, BL-40).
  //
  // One batch = one isolated run with a single llm-mode. `--batch=<name>` on
  // scripts/e2e-host.mjs expands `specs`; the batch `llmMode` applies unless
  // --llm-mode= (or XIHE_E2E_LLM_MODE) is given explicitly. Spec mode gates
  // live in the specs themselves: a run executes the cases whose gate matches
  // the selected mode and skips the rest (that is expected, not a failure).
  //
  // PLAN-0664/BL-267: narrow a batch with --only=<full path|basename|unique substring>; a differing --llm-mode(or env) is refused.
  //
  // Spec paths are relative to packages/ui (Playwright cwd).
  "batches": {
    "smoke": {
      "description": "stack smoke first: UI health + chat availability",
      "llmMode": "mock",
      "specs": ["e2e/real/ui-health.spec.ts", "e2e/real/chat-availability.spec.ts"]
    },
    "mock-full": {
      "description": "host lane full suite in mock mode (0368/0369 baseline 41P/0F/30S)",
      "llmMode": "mock",
      "specs": ["e2e/real"]
    },
    // NOTE (2026-11-03): there is NO batch for `e2e/mock/**` and there cannot be one —
    // the host runner appends `--grep @host` (playwright.config.ts:42) and **no mock spec
    // carries that tag** (they stub every API via page.route, so they need no stack), so a
    // batch would only ever report "No tests found". Run the mock lane standalone instead
    // (Playwright starts its own `pnpm dev` webServer, no docker/CP required):
    //
    //   cd packages/ui && pnpm exec playwright test --config e2e/playwright.config.ts \
    //       e2e/mock/approval.spec.ts                          # single spec
    //
    // `--config` is mandatory (the config is under e2e/, not the package root) — omitting it
    // silently drops baseURL/webServer and every `page.goto("/…")` fails with
    // "Cannot navigate to invalid URL".
    //
    // Known state at 2026-11-03 (whole lane, `playwright test --config e2e/playwright.config.ts e2e/mock`):
    // 136 passed / 49 failed. The four cases this lane first surfaced are fixed; their root
    // causes were **not** one missing fixture (corrected after trace-level diagnosis):
    //   - approval.spec.ts "shows auto mode warning…" / "workspace chat keeps the auto warning…"
    //     → product regression from PLAN-0626 M2-3 (`e0086773`): the only `policyStore.load()`
    //       caller moved into the dock, which is closed by default, so `GET /policy/mode` was
    //       never sent and the summary row read "未提供". Fixed in `SessionSettingsPanel.vue`.
    //   - context-templates.spec.ts "chat binding selector…" → the summary row is a second
    //     resolver instance and a successful rebind never reached the Session projection; the
    //     stub's session GET also never reflected the PATCH. Fixed in `SessionContextTemplate.vue`
    //     (+ `sessionStore.applySessionRecord`) and in the spec's session stub.
    //   - approval.spec.ts "switching away from an awaiting session…" → fixture gap: the session
    //     fixture dropped `agentPrincipalId`, so every send detoured into principal binding and no
    //     `/chat` POST happened. Fixed in `e2e/mock/helpers/auth.ts` + the approval fixture.
    // The remaining 49 failures are pre-existing and unrelated (config-settings, model-popover,
    // policy-management, sse-liveness, workspace-* …); `screenshots.spec.ts` order-dependent
    // "0 console errors" cases as well (settings-monitoring fails 3/3 in isolation on develop).
    "real-full": {
      "description": "host lane full suite on the real provider (key-gated; 0372 baseline 42P/0F/31S)",
      "llmMode": "real",
      "specs": ["e2e/real"]
    },
    "write-file": {
      "description": "deterministic write_file tool-call gate (journey-a/c, checkpoints, approval reuse, usage)",
      "llmMode": "write_file",
      "specs": [
        "e2e/real/journey-a.spec.ts",
        "e2e/real/journey-c.spec.ts",
        "e2e/real/checkpoint-slices.spec.ts",
        "e2e/real/checkpoint-rollback.spec.ts",
        "e2e/real/approval-reuse.spec.ts",
        "e2e/real/usage-line.spec.ts"
      ]
    },
    "approval": {
      "description": "approval pass/reject/persist chain",
      "llmMode": "approval",
      "specs": ["e2e/real/approval.spec.ts"]
    },
    "credential-acquire": {
      "description": "PLAN-0497 acquire_credential real chain: manual ask -> delivery -> memory-only value",
      "llmMode": "credential_acquire",
      "specs": ["e2e/real/credential-acquire.spec.ts"]
    },
    "credential-manager": {
      "description": "PLAN-0498 credential manager UI: registration, role block (ceiling), binding, lease use and reveal",
      "llmMode": "credential_acquire",
      "specs": ["e2e/real/credential-manager.spec.ts"]
    },
    "history-marker": {
      "description": "fake LLM history markers (journey-d D1/D2, circuit breaker)",
      "llmMode": "history-marker",
      "specs": ["e2e/real/journey-d.spec.ts", "e2e/real/journey-d-circuit.spec.ts"]
    },
    "job": {
      "description": "durable job archive and resume",
      "llmMode": "job",
      "specs": ["e2e/real/job-resume.spec.ts"]
    },
    "job-workspace-start": {
      "description": "PLAN-0390 workspace job start: idempotency, real docker job, cursor, cancel, LOST",
      "llmMode": "mock",
      "specs": ["e2e/real/plan0390-workspace-job-start.spec.ts"]
    },
    "job-cancel": {
      "description": "single job cancel four-phase termination",
      "llmMode": "job-cancel",
      "specs": ["e2e/real/plan0366-mcp-status-job-cancel.spec.ts"]
    },
    "exec-command": {
      "description": "diagnostics injection/rendering via exec_command",
      "llmMode": "exec_command",
      "specs": ["e2e/real/diagnostics.spec.ts"]
    },
    "overflow": {
      "description": "context overflow -> compact -> retry",
      "llmMode": "overflow",
      "specs": ["e2e/real/journey-d-overflow.spec.ts"]
    },
    "success": {
      "description": "user-layer config override applies to the next run",
      "llmMode": "success",
      "specs": ["e2e/real/config-run-effective.spec.ts"]
    },
    "profile-effective": {
      "description": "PLAN-0504: instance profile flows into the Agent snapshot; clearing fails closed",
      "llmMode": "success",
      "specs": ["e2e/real/plan-0504-profile-effective.spec.ts"]
    },
    "run-budget": {
      "description": "PLAN-0492 run budget exhaustion surface: config -> run failed -> takeover entry",
      "llmMode": "write_file",
      "specs": ["e2e/real/run-budget-exhaustion.spec.ts"]
    },
    "run-budget-calibration": {
      "description": "PLAN-0492 T0.3 token calibration over the real provider (requires XIHE_E2E_REAL_XIAOMI_KEY + XIHE_E2E_REAL_ROUTE=openai-compat; llmMode must be non-mock so the runner imports the real provider config)",
      "llmMode": "success",
      "specs": ["e2e/real/run-budget-calibration.spec.ts"]
    },
    "loop-observation": {
      "description": "PLAN-0493 T0.2 raw repeat/no-progress observation over the real provider (same env gates as run-budget-calibration)",
      "llmMode": "success",
      "specs": ["e2e/real/loop-observation.spec.ts"]
    },
    "loop-guard": {
      "description": "PLAN-0493 T3.2/T4.1 loop-guard stop over the scripted repeat fixture (fake LLM emits one identical glob call per turn)",
      "llmMode": "repeat",
      "specs": ["e2e/real/loop-guard.spec.ts"]
    },
    "evidence": {
      "description": "visual/manual evidence artifacts — run last, not a regular gate",
      "llmMode": "mock",
      "specs": ["e2e/real/screenshots.spec.ts", "e2e/real/settings-visual.spec.ts"]
    },
    "session-monitor": {
      "description": "PLAN-0507 right-panel session monitor: default-open, API cross-check, SSE-driven refresh, error/retry, stale recovery, mobile sheet",
      "llmMode": "mock",
      "specs": ["e2e/real/plan-0507-session-monitor.spec.ts"]
    },
    "transport": {
      "description": "PLAN-0508 provider-wire transport telemetry: normal / slow-first-response / provider-failure attempts through the CP relay + monitor diagnostics",
      "llmMode": "success",
      "specs": ["e2e/real/plan-0508-transport-telemetry.spec.ts"]
    },
    "workspace-members": {
      "description": "PLAN-0565 workspace members: settings UI journey (add/remove/role matrix) + real-chain permission matrix",
      "llmMode": "mock",
      "specs": ["e2e/real/workspace-members.spec.ts"]
    },
    "native-compat": {
      "description": "PLAN-0584 native CP: config JSON Schema API plus CP→Agent→Runtime write_file/SSE flow",
      "llmMode": "write_file",
      "specs": [
        "e2e/real/plan0584-native-config-schema.spec.ts",
        "e2e/real/journey-a.spec.ts"
      ]
    },
    // L2 窗口批次化（task-44；协议 SSOT = internal/A03-xihe/docs/l2-window-protocol.md）：
    // 窗口维度是 run（一套隔离栈 + 一个钉靶 SHA），一个 run 可承接多个 PLAN 的验收项。
    // 下面这些字段里只有 description / llmMode / specs 被 e2e-host.mjs 直接读取
    // （:195 / :277 / :279）；exclusive / stack / env / requiredEnv / expectTests /
    // reportNames / evidence 是给 scripts/e2e-batch-plan.mjs 与操作员的批次契约，
    // runner 不会自动应用 env —— 必须按 planner 打印的 $env: 行手动设置。
    // 追加成员的前置：带 @host 车道标签（packages/ui/e2e/playwright.config.ts:42 的
    // grep /@host/ 会过滤掉没有标签的 spec，表现为 No tests found）、self-seed、无顺序依赖。
    "l2-functional": {
      "description": "L2 功能批次（可合批）：self-seed 的 @host spec 共享一个 run 与一个钉靶 SHA；新成员须满足上方三个前置",
      "llmMode": "mock",
      "stack": "isolated",
      "exclusive": false,
      "specs": ["e2e/real/tool-cards.spec.ts"],
      "env": {},
      "requiredEnv": [],
      "expectTests": 2,
      "reportNames": {
        "e2e/real/tool-cards.spec.ts": "l2-tool-cards-{sha}.json"
      },
      "evidence": ".local/evidence/l2-functional-{sha}/"
    },
    "l2-measure": {
      "description": "L2 测量批次（独占 run）：bl382 会话规模采样；同 run 不得再跑任何 spec —— 旁路 spec 会改写 GC 压力与内存水位，量出来不是它要的数（PLAN-0682 T1.2）",
      "llmMode": "mock",
      "stack": "isolated",
      "exclusive": true,
      "specs": ["e2e/real/bl382-session-scale.spec.ts"],
      "env": {
        "XIHE_BL382_SELF_SEED": "1",
        "BL382_PROTOCOL": "{\"gcRounds\":2,\"samples\":5,\"sampleIntervalMs\":100}"
      },
      "requiredEnv": ["XIHE_BL382_TIER"],
      "expectTests": 1,
      "reportNames": {
        "e2e/real/bl382-session-scale.spec.ts": "l2-bl382-scale-{sha}.json"
      },
      "evidence": ".local/evidence/l2-measure-{sha}/"
    },
    "session-matrix": {
      "description": "PLAN-0658 session matrix real lane on the fake LLM: R1 multi human accounts (mutual visibility / @ mention / cc / non-participant denial), R2 TO speak-as wire, R3 three-role session visibility, R5 disabled-subject candidate/row filtering, R6 durable follow-up queue, R7 durable failure terminal, R8 refresh recovery (BL-228 guard), R9 reasoning durable parity",
      "llmMode": "success",
      "specs": [
        "e2e/real/session-matrix-multi-account.spec.ts",
        "e2e/real/session-matrix-to.spec.ts",
        "e2e/real/session-matrix-roles.spec.ts",
        "e2e/real/session-matrix-disabled.spec.ts",
        "e2e/real/session-matrix-concurrency.spec.ts",
        "e2e/real/session-matrix-failures.spec.ts",
        "e2e/real/session-matrix-refresh.spec.ts",
        "e2e/real/session-matrix-reasoning.spec.ts"
      ]
    }
  }
}
