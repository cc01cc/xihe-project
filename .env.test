# ============================================================
# XH test 环境基线（入库；E2E/集成测试，端口 +10000 偏移）
# 用法：XIHE_ENV=test（或模块 CLI --set XIHE_ENV=test）
# 注意：Host E2E 运行器使用每轮隔离端口/DB，自行注入 env，不依赖本文件
# ============================================================

XIHE_UI_PORT=22630
XIHE_CP_PORT=22631
XIHE_AGENT_PORT=22632
XIHE_RUNTIME_PORT=22633
XIHE_PG_PORT=22634

XIHE_CP_URL=http://127.0.0.1:22631
XIHE_CP_BASE_URL=http://127.0.0.1:22631
XIHE_AGENT_HOST=127.0.0.1
XIHE_RUNTIME_HOST=127.0.0.1
XIHE_CP_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:22634/xihe

XIHE_LLM_PROVIDER=mock              # test 不调真实 LLM
XIHE_LOG_LEVEL=info
