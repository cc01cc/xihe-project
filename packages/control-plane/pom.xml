<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.6</version>
    </parent>
    
    <groupId>com.cc01cc.p.xihe</groupId>
    <artifactId>control-plane</artifactId>
    <version>0.1.0</version>
    <packaging>jar</packaging>
    
    <properties>
        <java.version>25</java.version>
        <springdoc.version>3.1.0</springdoc.version>
        <resilience4j.version>2.4.0</resilience4j.version>
        <mapstruct.version>1.6.3</mapstruct.version>
        <flyway.version>13.4.0</flyway.version>
        <testcontainers.version>2.0.5</testcontainers.version>
        <testcontainers-junit.version>1.21.4</testcontainers-junit.version>
        <xihe.native.test.outputDirectory>${project.build.directory}/test-classes</xihe.native.test.outputDirectory>
    </properties>
    
    <dependencies>
        <!-- Core -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- WebSocket (XH Channel, PLAN-245; endpoint registered only when xihe.channel.enabled=true) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        
        <!-- Security & Auth -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        
        <!-- Database -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        <version>42.7.13</version>
            <scope>runtime</scope>
        </dependency>
        
        <!-- Migrations -->
        <!-- Spring Boot 4 moved Flyway auto-config into this module; without it
             the spring.flyway.* properties are silently ignored (PLAN-280). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
            <version>${flyway.version}</version>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <version>${flyway.version}</version>
            <scope>runtime</scope>
        </dependency>
        
        <!-- JWT -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.13.0</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.13.0</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.13.0</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        
        <!-- Actuator (health, metrics) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        
        <!-- OpenAPI docs -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>
        
        <!-- Resilience4j（暂移除：spring-boot3 模块仅兼容 SB 3.x，SB 4 需升级版本） -->
        <!-- <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-spring-boot3</artifactId>
            <version>${resilience4j.version}</version>
        </dependency> -->
        
        <!-- MapStruct (DTO mapping) -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>${mapstruct.version}</version>
        </dependency>

        <!-- JSON Schema validation -->
        <dependency>
            <groupId>com.networknt</groupId>
            <artifactId>json-schema-validator</artifactId>
            <version>3.0.7</version>
        </dependency>

        <!-- PDFBox (PDF splitting) -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>3.0.8</version>
        </dependency>
        
        <!-- Dev/Test -->
        <dependency>
            <groupId>io.github.cdimascio</groupId>
            <artifactId>dotenv-java</artifactId>
            <version>3.2.0</version>
        </dependency>

        <!-- Logstash Logback JSONL encoder -->
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>9.0</version>
        </dependency>

        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit</artifactId>
            <version>1.5.1</version>
            <scope>test</scope>
        </dependency>
        
        <!-- WireMock (HTTP stub server for cross-module integration tests) -->
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock-standalone</artifactId>
            <version>3.12.1</version>
            <scope>test</scope>
        </dependency>

        <!-- Testcontainers（核心 2.x，junit/postgresql 仍为 1.x，BOM 未完全覆盖） -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${testcontainers-junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <version>${testcontainers-junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>
    
    <build>
        <testOutputDirectory>${xihe.native.test.outputDirectory}</testOutputDirectory>
        <!-- PLAN-0534: pom.properties is the runtime projection of <version>.
             Filter only this file; all other resources are copied verbatim. -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>META-INF/maven/com.cc01cc.p.xihe/control-plane/pom.properties</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>META-INF/maven/com.cc01cc.p.xihe/control-plane/pom.properties</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>3.6.0</version>
                <configuration>
                    <configLocation>checkstyle.xml</configLocation>
                    <violationSeverity>error</violationSeverity>
                    <failOnViolation>true</failOnViolation>
                    <includeTestSourceDirectory>true</includeTestSourceDirectory>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>native-build</id>
            <build>
                <plugins>
                    <!-- PLAN-0584: opt-in only; the Spring Boot parent manages plugin version and native profile configuration. -->
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                    </plugin>
                    <!-- PLAN-0584 T1.6: Test AOT scans all Spring tests in this directory. Keep it aligned
                         with Native Build Tools' project test output root; native-test-probe narrows that root. -->
                    <plugin>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>process-test-aot</id>
                                <configuration>
                                    <testClassesDirectory>${project.build.testOutputDirectory}</testClassesDirectory>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>native-test-probe</id>
            <properties>
                <xihe.native.test.outputDirectory>${project.build.directory}/native-probe-test-classes</xihe.native.test.outputDirectory>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <configuration>
                            <testIncludes>
                                <testInclude>**/NativeImageCompatibilityProbeTest.java</testInclude>
                            </testIncludes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>native-aot</id>
            <build>
                <plugins>
                    <!-- PLAN-0584: process-aot activates Spring `native-aot`; DotenvLoader CLI overrides supply run-scoped XIHE values to the primary Hikari DataSource. Keep credentials environment-only and omit Jakarta JDBC URL/user overrides so Hibernate uses Hikari's no-arg connection; dialect remains explicit. -->
                    <plugin>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-maven-plugin</artifactId>
                        <configuration>
                            <profiles>
                                <profile>native-aot</profile>
                            </profiles>
                            <!-- process-aot exposes systemPropertyVariables (not the run goal's environmentVariables). -->
                            <systemPropertyVariables>
                                <XIHE_LOAD_DOTENV>0</XIHE_LOAD_DOTENV>
                                <XIHE_PG_PORT>${env.XIHE_PG_PORT}</XIHE_PG_PORT>
                                <spring.datasource.url>${env.XIHE_CP_DATASOURCE_URL}</spring.datasource.url>
                                <spring.datasource.username>${env.XIHE_CP_DATASOURCE_USERNAME}</spring.datasource.username>
                                <spring.jpa.database-platform>org.hibernate.dialect.PostgreSQLDialect</spring.jpa.database-platform>
                                <spring.aot.jpa.repositories.use-entitymanager>true</spring.aot.jpa.repositories.use-entitymanager>
                                <hibernate.dialect>org.hibernate.dialect.PostgreSQLDialect</hibernate.dialect>
                                <xihe.channel.enabled>${env.XIHE_CHANNEL_ENABLED}</xihe.channel.enabled>
                            </systemPropertyVariables>
                            <arguments>
                                <argument>--spring.datasource.url=${env.XIHE_CP_DATASOURCE_URL}</argument>
                                <argument>--spring.datasource.username=${env.XIHE_CP_DATASOURCE_USERNAME}</argument>
                                <argument>--spring.jpa.database-platform=org.hibernate.dialect.PostgreSQLDialect</argument>
                                <argument>--spring.aot.jpa.repositories.use-entitymanager=true</argument>
                                <argument>--hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect</argument>
                                <argument>--xihe.channel.enabled=${env.XIHE_CHANNEL_ENABLED}</argument>
                                <argument>--set=XIHE_LOAD_DOTENV=0</argument>
                                <argument>--set=XIHE_CP_DATASOURCE_URL=${env.XIHE_CP_DATASOURCE_URL}</argument>
                                <argument>--set=XIHE_CP_DATASOURCE_USERNAME=${env.XIHE_CP_DATASOURCE_USERNAME}</argument>
                                <argument>--set=XIHE_CHANNEL_ENABLED=${env.XIHE_CHANNEL_ENABLED}</argument>
                                <argument>--set=XIHE_PG_PORT=${env.XIHE_PG_PORT}</argument>
                            </arguments>
                            <jvmArguments>-DXIHE_LOAD_DOTENV=0 -DXIHE_PG_PORT=${env.XIHE_PG_PORT} -Dspring.datasource.url=${env.XIHE_CP_DATASOURCE_URL} -Dspring.datasource.username=${env.XIHE_CP_DATASOURCE_USERNAME} -Dspring.jpa.database-platform=org.hibernate.dialect.PostgreSQLDialect -Dspring.aot.jpa.repositories.use-entitymanager=true -Dhibernate.dialect=org.hibernate.dialect.PostgreSQLDialect -Dxihe.channel.enabled=${env.XIHE_CHANNEL_ENABLED}</jvmArguments>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
