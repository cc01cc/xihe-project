    <properties>
        <!-- PLAN-0618: the single switch for frozen docker tests (default: excluded). -->
        <docker.frozen.excludedGroups>docker-frozen</docker.frozen.excludedGroups>
        <java.version>25</java.version>
        <springdoc.version>3.2.0</springdoc.version>
