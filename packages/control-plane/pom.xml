    <build>
        <!-- D32-26 T2 + task-8: parameterised build directory.
             Default `target`; `-Dxihe.build.suffix=-b` ⇒ `target-b`;
             `-Dxihe.target.dir=<abs>` ⇒ that directory (any volume). -->
        <directory>${xihe.target.dir}</directory>
        <testOutputDirectory>${xihe.native.test.outputDirectory}</testOutputDirectory>
        <!-- PLAN-0534: pom.properties is the runtime projection of <version>.
             Filter only this file; all other resources are copied verbatim. -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>META-INF/maven/com.cc01cc.p.xihe/control-plane/pom.properties</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>META-INF/maven/com.cc01cc.p.xihe/control-plane/pom.properties</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- PLAN-0618: docker-frozen tests are excluded by default (frozen backend) but kept in
                         the tree; -Dgroups=docker-frozen restores them. Inventory:
                         plans/PLAN-0618-XH-docker-freeze-complete/evidence/m3-frozen-tests.md -->
                    <excludedGroups>${docker.frozen.excludedGroups}</excludedGroups>
                    <!-- task-243: two forked JVMs by default (override per run; measurement windows
                         must pass -Dxihe.test.forkCount=1 — see the property comment above).
                         Each fork owns its own Spring context and Testcontainers PG, so a 2-fork
                         run has two PG containers; test classes themselves stay sequential. -->
                    <forkCount>${xihe.test.forkCount}</forkCount>
                    <reuseForks>true</reuseForks>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>3.6.0</version>
                <!-- task-45: severity/blocking are shared by BOTH executions (product and
                     test); only the ruleset and the scanned directory differ per execution.
                     `-Dcheckstyle.skip=true` still disables both (plugin-level `skip`). -->
                <!-- 插件级配置 = 单独 `mvn -o checkstyle:check`（生命周期外调用，default-cli）
                     时的口径：产品域脚本 + 产品目录。**这一层不能省 configLocation**：
                     省了 default-cli 会回落到插件内置的 sun_checks.xml，实测报出 56918 条
                     违规（与真正的门无关的噪声）。各 execution 只覆盖自己需要的两项
                     （configLocation / sourceDirectories），阻断强度仍共用这里。 -->
                <configuration>
                    <configLocation>checkstyle.xml</configLocation>
                    <sourceDirectories>
                        <sourceDirectory>${project.basedir}/src/main/java</sourceDirectory>
                    </sourceDirectories>
                    <violationSeverity>error</violationSeverity>
                    <failOnViolation>true</failOnViolation>
                    <includeTestSourceDirectory>false</includeTestSourceDirectory>
                </configuration>
                <executions>
                    <!-- ===== 产品域（src/main/java），规则集 = checkstyle.xml =====
                         task-45：这里只扫产品源码。测试源码走下面独立的第二个 execution，
                         两者共用 violationSeverity=error + failOnViolation=true（阻断强度不降）。 -->
                    <execution>
                        <id>checkstyle-check-early</id>
                        <configuration>
                            <configLocation>checkstyle.xml</configLocation>
                            <sourceDirectories>
                                <sourceDirectory>${project.basedir}/src/main/java</sourceDirectory>
                            </sourceDirectories>
                        </configuration>
                        <!-- task-583（Lead 2026-11-14 派；cp-1 查实 33bd1786e1 带未用 import 进主干）：
                             这道门原来**没有显式 phase**，而 checkstyle:check 的 Mojo 默认相位是 verify
                             （maven-checkstyle-plugin 3.6.0 的 plugin.xml: <phase>verify</phase>）。
                             日常开发命令是 `mvn -o -q test-compile` / `mvn -o test -Dtest=X`（本包
                             AGENTS.md §命令），它们**到不了 verify** ⇒ 门从不执行，红也看不见。
                             这里钉死在 validate（生命周期最前一档）：任何走生命周期的 mvn 命令都会先过
                             checkstyle，且失败发生在编译之前（比 verify 早，比"记得单独跑"可靠）。
                             代价实测 2.2 s（mvn -o -q checkstyle:check 全量，基线 0 违规）；
                             逃生口与 Maven 惯例一致：-Dcheckstyle.skip=true（显式、可见、不默认关）。 -->
                        <phase>validate</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>

                    <!-- ===== 测试域（src/test/java），规则集 = checkstyle-test.xml =====
                         task-45 / BL-306：绑到 test-compile —— 该相位第一件事就是"测试源码要能编译"，
                         所以测试规则在这里红最便宜（编译之前，不是测试跑完之后）。
                         为什么 validate 不扫测试：validate 早于 test-compile，那时 test 源还没有
                         被任何东西需要；把测试规则也钉在 validate 会让"只跑了部分生命周期"的
                         命令（例如 mvn validate 只想起个编译检查）假性变慢、也让职责不清。
                         两个 execution 是**并列**关系，各自独立判定 failOnViolation；
                         validate 阶段的 checkstyle-check-early 不依赖 test-compile，不会被跳过。 -->
                    <execution>
                        <id>checkstyle-test-early</id>
                        <phase>test-compile</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <configLocation>checkstyle-test.xml</configLocation>
                            <sourceDirectories>
                                <sourceDirectory>${project.basedir}/src/test/java</sourceDirectory>
                            </sourceDirectories>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <!-- PLAN-eff/task-13 M1：2-shard 切分（按 M0 实测的包级秒数装箱，两半各 ≈480 s）。
             用法：两个进程并行，各自一个 JVM / 一个单例容器：
                 mvn -o test -Pl2-shard-a
                 mvn -o test -Pl2-shard-b
             A 用 includes 列出它的包；B 用 excludes 排除同一批包来表达"其余" ⇒
             新增测试类只要不在 A 的包里就自动落 B，**不会静默漏跑**（有专门的并集校验）。
             两 shard 的报告分别落 target/surefire-reports-shard-{a,b}，由调用方合并失败集。
             注意：单进程仍用默认 profile（不带 -Pl2-shard-*），行为与改动前一致。 -->
        <profile>
            <id>l2-shard-a</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <reportsDirectory>${project.build.directory}/surefire-reports-shard-a</reportsDirectory>
                            <!-- task-243: the 2-shard lane is already parallel at the *process* level
                                 (two Maven runs), and its 301–343 s measurement was taken with one
                                 fork per shard. Pinning 1 keeps that baseline comparable and avoids
                                 4 PGs (2 shards × 2 forks) on this host. -->
                            <forkCount>1</forkCount>
                            <includes>
                                <include>**/chat/**/*Test.java</include>
                                <include>**/auth/**/*Test.java</include>
                                <include>**/operation/**/*Test.java</include>
                                <include>**/crossmodule/**/*Test.java</include>
                                <include>**/audit/**/*Test.java</include>
                                <include>**/mcp/**/*Test.java</include>
                                <include>**/oauth/**/*Test.java</include>
                                <include>**/repository/**/*Test.java</include>
                                <include>**/integration/**/*Test.java</include>
                                <include>**/telemetry/**/*Test.java</include>
                                <include>**/api/**/*Test.java</include>
                                <include>**/checkpoint/**/*Test.java</include>
                            </includes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>l2-shard-b</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <reportsDirectory>${project.build.directory}/surefire-reports-shard-b</reportsDirectory>
                            <!-- task-243: same pin as shard A — the shard lane's measured baseline is
                                 one fork per process (see the default surefire comment above). -->
                            <forkCount>1</forkCount>
                            <includes>
                                <include>**/Test*.java</include>
                                <include>**/*Test.java</include>
                                <include>**/*Tests.java</include>
                                <include>**/*TestCase.java</include>
                            </includes>
                            <excludes>
                                <exclude>**/chat/**/*Test.java</exclude>
                                <exclude>**/auth/**/*Test.java</exclude>
                                <exclude>**/operation/**/*Test.java</exclude>
                                <exclude>**/crossmodule/**/*Test.java</exclude>
                                <exclude>**/audit/**/*Test.java</exclude>
                                <exclude>**/mcp/**/*Test.java</exclude>
                                <exclude>**/oauth/**/*Test.java</exclude>
                                <exclude>**/repository/**/*Test.java</exclude>
                                <exclude>**/integration/**/*Test.java</exclude>
                                <exclude>**/telemetry/**/*Test.java</exclude>
                                <exclude>**/api/**/*Test.java</exclude>
                                <exclude>**/checkpoint/**/*Test.java</exclude>
                            </excludes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>native-build</id>
            <build>
                <plugins>
                    <!-- PLAN-0584: opt-in only; the Spring Boot parent manages plugin version and native profile configuration. -->
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                    </plugin>
                    <!-- PLAN-0584 T1.6: Test AOT scans all Spring tests in this directory. Keep it aligned
                         with Native Build Tools' project test output root; native-test-probe narrows that root. -->
                    <plugin>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>process-test-aot</id>
                                <configuration>
                                    <testClassesDirectory>${project.build.testOutputDirectory}</testClassesDirectory>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>native-test-probe</id>
            <properties>
                <xihe.native.test.outputDirectory>${project.build.directory}/native-probe-test-classes</xihe.native.test.outputDirectory>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <configuration>
                            <testIncludes>
                                <testInclude>**/NativeImageCompatibilityProbeTest.java</testInclude>
                            </testIncludes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>native-aot</id>
            <build>
                <plugins>
                    <!-- PLAN-0584: process-aot activates Spring `native-aot`; DotenvLoader CLI overrides supply run-scoped XIHE values to the primary Hikari DataSource. Keep credentials environment-only and omit Jakarta JDBC URL/user overrides so Hibernate uses Hikari's no-arg connection; dialect remains explicit. -->
                    <plugin>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-maven-plugin</artifactId>
                        <configuration>
                            <profiles>
                                <profile>native-aot</profile>
                            </profiles>
                            <!-- process-aot exposes systemPropertyVariables (not the run goal's environmentVariables). -->
                            <systemPropertyVariables>
                                <XIHE_LOAD_DOTENV>0</XIHE_LOAD_DOTENV>
                                <XIHE_PG_PORT>${env.XIHE_PG_PORT}</XIHE_PG_PORT>
                                <spring.datasource.url>${env.XIHE_CP_DATASOURCE_URL}</spring.datasource.url>
                                <spring.datasource.username>${env.XIHE_CP_DATASOURCE_USERNAME}</spring.datasource.username>
                                <spring.jpa.database-platform>org.hibernate.dialect.PostgreSQLDialect</spring.jpa.database-platform>
                                <spring.aot.jpa.repositories.use-entitymanager>true</spring.aot.jpa.repositories.use-entitymanager>
                                <hibernate.dialect>org.hibernate.dialect.PostgreSQLDialect</hibernate.dialect>
                                <xihe.channel.enabled>${env.XIHE_CHANNEL_ENABLED}</xihe.channel.enabled>
