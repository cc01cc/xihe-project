        <testcontainers-junit.version>1.21.4</testcontainers-junit.version>
        <xihe.native.test.outputDirectory>${project.build.directory}/test-classes</xihe.native.test.outputDirectory>
        <!--
          PLAN-0632 D32-26 T2: per-runner build directory suffix.

          Why: two concurrent `mvn test` runs on the SAME tree would otherwise share
          `target/classes`, `target/test-classes` and `target/surefire-reports*`. Maven has no
          locking there, so the two runs silently overwrite each other's outputs — the failure mode
          is a false green / false red, not an error (2026-11-02: a shard run wrote its reports into
          `surefire-reports-shard-a/b` and anything reading the default directory read half the
          suite). The already-sanctioned 2-shard lane (profiles `l2-shard-a/b`) avoids this by
          compiling ONCE and forking only `surefire:test` with distinct report dirs; this property
          is for the other case: two full independent `mvn test` runs.

          Usage: `mvn -Dxihe.build.suffix=-b test` builds into `target-b/`. Default is empty, so
          every existing command, CI script and IDE keeps using plain `target/`.
          PowerShell caveat: quote it (`"-Dxihe.build.suffix=-b"`), otherwise the leading dash of the
          value is parsed as another flag and Maven reports `LifecyclePhaseNotFoundException`.
          `.gitignore` must keep ignoring `target*/`.
        -->
        <xihe.build.suffix></xihe.build.suffix>
        <!--
          task-8: absolute build-directory override, so two lanes can build the SAME checkout in
          parallel without sharing one `target/` (the race the D32-26 note above describes).

          Usage: `mvn -o -q "-Dxihe.target.dir=<abs-path>" test-compile` (or `test`). The whole output
          tree moves — `classes`, `test-classes`, `surefire-reports` — so the two runs cannot delete
          each other's class files mid-test. Prefer a directory outside the checkout (and, on this
          machine, outside `H:`): `H:\zeotmp\cp-build-a`, `C:/xihe-cp-build-b`.

          Default = `${project.basedir}/target${xihe.build.suffix}`, i.e. byte-for-byte the previous
          behaviour: plain `mvn` still uses `target/`, and `-Dxihe.build.suffix=-b` still produces
          `target-b/`. An explicit `-Dxihe.target.dir` wins over the suffix (it is the absolute form).
        -->
        <xihe.target.dir>${project.basedir}/target${xihe.build.suffix}</xihe.target.dir>
        <!--
          task-243: surefire fork count for `mvn test` (multi-core execution).

          Why: the default of one fork uses one core of the 32-core host for the 15-minute full run.
          User ruling 2026-11-08: multi-core execution is allowed; the default here is 2 so a plain
          `mvn test` overlaps two class groups without requiring a new command. Override per run with
          `-Dxihe.test.forkCount=1` (serial) or `=4` (data-only experiment, not a default).

          Measurement-window rule: any run whose wall-clock / peak-RSS numbers are quoted as evidence
          (measurement classes, L2 comparisons) MUST pass `-Dxihe.test.forkCount=1`. Fork count changes
          the GC and memory numbers, so a 2-fork run is not comparable to the historical 1-fork baselines
          (see `test-suite-cost.md` P5 and the l2-window protocol).

          `reuseForks=true`: `forkCount` is a reuse pool size, so each fork survives across classes
          (no JVM restart per class) instead of `forkCount` sequential single-use forks. JUnit `parallel`
          is deliberately NOT enabled here (P7 deferred: per-test parallelism needs isolation work).
        -->
        <xihe.test.forkCount>2</xihe.test.forkCount>
    </properties>
    
