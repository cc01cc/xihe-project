{
  "type": "object",
  "properties": {
    "useRegistry": { "type": "string", "enum": ["true", "false"] },
    "useSupervisor": { "type": "string", "enum": ["true", "false"] },
    "workersDir": { "type": "string" },
    "instructions": { "type": "string" },
    "systemToolTimeoutS": { "type": ["integer", "string"], "minimum": 1, "maximum": 30, "pattern": "^(30|[12][0-9]|[1-9])$" },
    "toolOutputLimitBytes": { "type": ["integer", "string"], "minimum": 1 },
    "runMaxTurns": { "type": ["integer", "string"], "minimum": 0, "pattern": "^(0|[1-9][0-9]*)$" },
    "runMaxElapsedSeconds": { "type": ["integer", "string"], "minimum": 0, "pattern": "^(0|[1-9][0-9]*)$" },
    "runMaxTokens": { "type": ["integer", "string"], "minimum": 0, "pattern": "^(0|[1-9][0-9]*)$" },
    "runMaxTurnsCeiling": { "type": ["integer", "string"], "minimum": 0, "pattern": "^(0|[1-9][0-9]*)$" },
    "runMaxElapsedSecondsCeiling": { "type": ["integer", "string"], "minimum": 0, "pattern": "^(0|[1-9][0-9]*)$" },
    "runMaxTokensCeiling": { "type": ["integer", "string"], "minimum": 0, "pattern": "^(0|[1-9][0-9]*)$" },
    "loopRepeatWarn": { "type": ["integer", "string"], "minimum": 1, "pattern": "^[1-9][0-9]*$" },
    "loopRepeatRefuse": { "type": ["integer", "string"], "minimum": 1, "pattern": "^[1-9][0-9]*$" },
    "loopRepeatEscalate": { "type": ["integer", "string"], "minimum": 1, "pattern": "^[1-9][0-9]*$" },
    "loopErrorRunWarn": { "type": ["integer", "string"], "minimum": 1, "pattern": "^[1-9][0-9]*$" },
    "loopErrorRunEscalate": { "type": ["integer", "string"], "minimum": 1, "pattern": "^[1-9][0-9]*$" },
    "loopStaleResultWarn": { "type": ["integer", "string"], "minimum": 1, "pattern": "^[1-9][0-9]*$" },
    "loopStaleResultEscalate": { "type": ["integer", "string"], "minimum": 1, "pattern": "^[1-9][0-9]*$" },
    "loopWindowSize": { "type": ["integer", "string"], "minimum": 1, "pattern": "^[1-9][0-9]*$" },
    "loopRepeatEscalateCeiling": { "type": ["integer", "string"], "minimum": 0, "pattern": "^(0|[1-9][0-9]*)$" },
    "loopErrorRunEscalateCeiling": { "type": ["integer", "string"], "minimum": 0, "pattern": "^(0|[1-9][0-9]*)$" },
    "loopStaleResultEscalateCeiling": { "type": ["integer", "string"], "minimum": 0, "pattern": "^(0|[1-9][0-9]*)$" },
    "loopWindowSizeCeiling": { "type": ["integer", "string"], "minimum": 0, "pattern": "^(0|[1-9][0-9]*)$" },
    "loopExemptTools": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]*$"
      },
      "maxItems": 64
    }
  },
  "additionalProperties": false
}
