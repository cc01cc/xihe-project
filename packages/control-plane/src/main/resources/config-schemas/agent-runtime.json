{
  "type": "object",
  "properties": {
    "useRegistry": { "type": "string", "enum": ["true", "false"] },
    "useSupervisor": { "type": "string", "enum": ["true", "false"] },
    "providerRequestFingerprintEnabled": { "type": "string", "enum": ["true", "false"] },
    "workersDir": { "type": "string" },
    "instructions": { "type": "string" },
    "systemToolTimeoutS": { "type": ["integer", "string"], "minimum": 1, "maximum": 30, "pattern": "^(30|[12][0-9]|[1-9])$" },
    "toolOutputLimitBytes": { "type": ["integer", "string"], "minimum": 1 },
    "runMaxTurns": { "type": ["integer", "string"], "minimum": 0, "pattern": "^(0|[1-9][0-9]*)$" },
    "runMaxElapsedSeconds": { "type": ["integer", "string"], "minimum": 0, "pattern": "^(0|[1-9][0-9]*)$" },
    "runMaxTokens": { "type": ["integer", "string"], "minimum": 0, "pattern": "^(0|[1-9][0-9]*)$", "description": "Cumulative run token budget; default 500000 (~73 LLM calls at the task-91 measured ~6.8k/call). 0 disables this dimension." },
    "runMaxTurnsCeiling": { "type": ["integer", "string"], "minimum": 0, "pattern": "^(0|[1-9][0-9]*)$" },
    "runMaxElapsedSecondsCeiling": { "type": ["integer", "string"], "minimum": 0, "pattern": "^(0|[1-9][0-9]*)$" },
    "runMaxTokensCeiling": { "type": ["integer", "string"], "minimum": 0, "pattern": "^(0|[1-9][0-9]*)$", "description": "Instance-only clamp for runMaxTokens; default 1000000 and must stay above the value, otherwise min(value, ceiling) silently caps it." },
    "loopRepeatWarn": { "type": ["integer", "string"], "minimum": 1, "pattern": "^[1-9][0-9]*$" },
    "loopRepeatRefuse": { "type": ["integer", "string"], "minimum": 1, "pattern": "^[1-9][0-9]*$" },
    "loopRepeatEscalate": { "type": ["integer", "string"], "minimum": 1, "pattern": "^[1-9][0-9]*$" },
    "loopErrorRunWarn": { "type": ["integer", "string"], "minimum": 1, "pattern": "^[1-9][0-9]*$" },
    "loopErrorRunEscalate": { "type": ["integer", "string"], "minimum": 1, "pattern": "^[1-9][0-9]*$" },
    "loopStaleResultWarn": { "type": ["integer", "string"], "minimum": 1, "pattern": "^[1-9][0-9]*$" },
    "loopStaleResultEscalate": { "type": ["integer", "string"], "minimum": 1, "pattern": "^[1-9][0-9]*$" },
    "loopWindowSize": { "type": ["integer", "string"], "minimum": 1, "pattern": "^[1-9][0-9]*$" },
    "loopRepeatEscalateCeiling": { "type": ["integer", "string"], "minimum": 0, "pattern": "^(0|[1-9][0-9]*)$" },
    "loopErrorRunEscalateCeiling": { "type": ["integer", "string"], "minimum": 0, "pattern": "^(0|[1-9][0-9]*)$" },
    "loopStaleResultEscalateCeiling": { "type": ["integer", "string"], "minimum": 0, "pattern": "^(0|[1-9][0-9]*)$" },
    "loopWindowSizeCeiling": { "type": ["integer", "string"], "minimum": 0, "pattern": "^(0|[1-9][0-9]*)$" },
    "wakeChainMaxDepth": { "type": ["integer", "string"], "minimum": 1, "maximum": 10, "pattern": "^([1-9]|10)$" },
    "maxConcurrentRunsPerSession": { "type": ["integer", "string"], "minimum": 1, "maximum": 4, "pattern": "^[1-4]$" },
    "delegationMaxCountCeiling": { "type": ["integer", "string"], "minimum": 0, "pattern": "^(0|[1-9][0-9]*)$" },
    "delegationMaxDepthCeiling": { "type": ["integer", "string"], "minimum": 0, "pattern": "^(0|[1-9][0-9]*)$" },
    "loopExemptTools": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]*$"
      },
      "maxItems": 64
    },
    "defaultParticipants": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["principalKind", "principalId"],
        "properties": {
          "principalKind": { "type": "string", "enum": ["HUMAN", "AGENT"] },
          "principalId": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" },
          "role": { "type": "string", "enum": ["MEMBER", "GUARD"] },
          "wakePolicy": { "type": "string", "enum": ["ALL_MESSAGES", "MENTION"] },
          "respondPolicy": { "type": "string", "enum": ["ALWAYS", "WHEN_MENTIONED", "JUDGE", "MUTED"] },
          "deliveryDefaults": {
            "type": "array",
            "maxItems": 3,
            "uniqueItems": true,
            "items": { "type": "string", "enum": ["to", "cc", "mention_only"] }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
