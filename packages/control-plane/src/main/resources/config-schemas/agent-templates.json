{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xihe.dev/config-schemas/agent-templates.json",
  "type": "object",
  "properties": {
    "roles": {
      "type": "array",
      "items": { "$ref": "#/$defs/role" }
    },
    "templates": {
      "type": "array",
      "items": { "$ref": "#/$defs/template" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "permission": {
      "type": "object",
      "required": ["actionClass"],
      "properties": {
        "actionClass": { "type": "string", "minLength": 1 },
        "resource": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "role": {
      "type": "object",
      "required": ["id", "name", "permissions"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "name": { "type": "string", "minLength": 1 },
        "permissions": {
          "type": "array",
          "items": { "$ref": "#/$defs/permission" }
        }
      },
      "additionalProperties": false
    },
    "template": {
      "type": "object",
      "required": ["id", "name", "description", "systemPrompt", "toolMode", "roleId"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "systemPrompt": { "type": "string", "minLength": 1 },
        "toolMode": { "enum": ["none", "workspace"] },
        "provider": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "roleId": { "$ref": "#/$defs/uuid" }
      },
      "additionalProperties": false
    }
  }
}
