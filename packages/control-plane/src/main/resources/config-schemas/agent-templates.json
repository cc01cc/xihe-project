{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xihe.dev/config-schemas/agent-templates.json",
  "type": "object",
  "properties": {
    "roles": {
      "type": "array",
      "items": { "$ref": "#/$defs/role" }
    },
    "templates": {
      "type": "array",
      "items": { "$ref": "#/$defs/template" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "permission": {
      "type": "object",
      "required": ["actionClass"],
      "properties": {
        "actionClass": { "type": "string", "minLength": 1 },
        "resource": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "actionClass": { "pattern": "^credential_" } },
            "required": ["actionClass"]
          },
          "then": {
            "required": ["resource"],
            "properties": {
              "resource": {
                "pattern": "^credential:(\\*|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
              }
            }
          }
        }
      ]
    },
    "role": {
      "type": "object",
      "required": ["id", "name", "permissions"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "name": { "type": "string", "minLength": 1 },
        "permissions": {
          "type": "array",
          "items": { "$ref": "#/$defs/permission" }
        }
      },
      "additionalProperties": false
    },
    "template": {
      "type": "object",
      "required": ["id", "name", "description", "systemPrompt", "toolMode", "roleId"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "systemPrompt": { "type": "string", "minLength": 1 },
        "toolMode": { "enum": ["none", "workspace"] },
        "provider": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "roleId": { "$ref": "#/$defs/uuid" },
        "hooks": { "$ref": "#/$defs/hookSubscriptions" }
      },
      "additionalProperties": false
    },
    "hookSubscriptions": {
      "description": "PLAN-0625 D25-09: hook subscriptions declared by a template; copied to the principal at creation as its DEFAULT. Null = no subscriptions (the V98 corrective is reversible to jsonb null, and AgentPrincipalService treats null as absent).",
      "type": ["object", "null"],
      "required": ["advisors"],
      "properties": {
        "advisors": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/hookAdvisor" }
        }
      }
    },
    "hookAdvisor": {
      "description": "D25-10: `kind` stays an open string (implementing HookAdvisor is the whole plugin contract, so new kinds appear without a schema change); the entry itself stays open to future per-advisor parameters so an added key can never 409 the read path again.",
      "type": "object",
      "required": ["kind", "on"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "on": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
