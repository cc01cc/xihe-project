import json

import pytest

import xihe_agent.main as agent


class FakeResponse:
    def __init__(self, *, json_data=None, lines=None):
        self._json_data = json_data
        self._lines = lines or []

    def raise_for_status(self):
        return None

    def json(self):
        return self._json_data

    async def aiter_lines(self):
        for line in self._lines:
            yield line


class FakeAsyncClient:
    def __init__(self, responses, calls):
        self._responses = responses
        self._calls = calls

    async def __aenter__(self):
        return self

    async def __aexit__(self, exc_type, exc, tb):
        return False

    async def post(self, url, headers=None, json=None, timeout=None):
        self._calls.append(
            {
                "url": url,
                "headers": headers,
                "json": json,
                "timeout": timeout,
            }
        )
        return self._responses.pop(0)


async def collect_streaming_response(response):
    chunks = []
    async for chunk in response.body_iterator:
        chunks.append(chunk.decode() if isinstance(chunk, bytes) else chunk)
    return "".join(chunks)


@pytest.mark.asyncio
async def test_deepseek_response_executes_tool_calls(monkeypatch):
    calls = []
    responses = [
        FakeResponse(
            json_data={
                "choices": [
                    {
                        "message": {
                            "role": "assistant",
                            "content": "",
                            "tool_calls": [
                                {
                                    "id": "call_1",
                                    "type": "function",
                                    "function": {
                                        "name": "read_file",
                                        "arguments": json.dumps({"path": "test.txt"}),
                                    },
                                }
                            ],
                        }
                    }
                ]
            }
        ),
        FakeResponse(
            json_data={
                "choices": [
                    {
                        "message": {
                            "role": "assistant",
                            "content": "我读取到了文件内容。",
                        }
                    }
                ]
            }
        ),
    ]

    monkeypatch.setattr(
        agent.httpx,
        "AsyncClient",
        lambda *args, **kwargs: FakeAsyncClient(responses, calls),
    )
    monkeypatch.setattr(agent, "DEEPSEEK_API_KEY", "test-key")
    monkeypatch.setattr(agent, "DEEPSEEK_MODEL", "test-model")
    monkeypatch.setattr(agent, "DEEPSEEK_API_BASE", "https://example.com/v1")
    monkeypatch.setattr(
        agent,
        "available_tools",
        [
            {
                "name": "read_file",
                "description": "Read a file from the workspace",
                "inputSchema": {
                    "type": "object",
                    "properties": {"path": {"type": "string"}},
                    "required": ["path"],
                },
            }
        ],
    )

    async def fake_mcp_call_tool(tool_name, arguments):
        assert tool_name == "read_file"
        assert arguments == {"path": "test.txt"}
        return {"content": [{"type": "text", "text": "Hello from xihe workspace"}]}

    monkeypatch.setattr(agent, "mcp_call_tool", fake_mcp_call_tool)

    response = await agent.deepseek_response("读取 test.txt", "session-1")
    body = await collect_streaming_response(response)

    assert "event: tool_exec_started" in body
    assert "event: tool_exec_done" in body
    assert "read_file" in body
    assert "我读取到了文件内容。" in body
    assert "event: done" in body
    assert len(calls) == 2
    assert calls[0]["json"]["tools"][0]["function"]["name"] == "read_file"
    assert any(
        message.get("role") == "tool"
        and "Hello from xihe workspace" in message.get("content", "")
        for message in calls[1]["json"]["messages"]
    )
    assert calls[1]["json"]["tool_choice"] == "auto"


@pytest.mark.asyncio
async def test_deepseek_response_uses_direct_content_without_second_call(monkeypatch):
    calls = []
    responses = [
        FakeResponse(
            json_data={
                "choices": [
                    {
                        "message": {
                            "role": "assistant",
                            "content": "你好，我是 DeepSeek。",
                        }
                    }
                ]
            }
        )
    ]

    monkeypatch.setattr(
        agent.httpx,
        "AsyncClient",
        lambda *args, **kwargs: FakeAsyncClient(responses, calls),
    )
    monkeypatch.setattr(agent, "DEEPSEEK_API_KEY", "test-key")
    monkeypatch.setattr(agent, "DEEPSEEK_MODEL", "test-model")
    monkeypatch.setattr(agent, "DEEPSEEK_API_BASE", "https://example.com/v1")
    monkeypatch.setattr(
        agent,
        "available_tools",
        [
            {
                "name": "read_file",
                "description": "Read a file from the workspace",
                "inputSchema": {
                    "type": "object",
                    "properties": {"path": {"type": "string"}},
                },
            }
        ],
    )

    response = await agent.deepseek_response("你好", "session-2")
    body = await collect_streaming_response(response)

    assert "你好，我是 DeepSeek。" in body
    assert "event: done" in body
    assert len(calls) == 1


@pytest.mark.asyncio
async def test_deepseek_response_supports_multiple_tool_rounds(monkeypatch):
    calls = []
    responses = [
        FakeResponse(
            json_data={
                "choices": [
                    {
                        "message": {
                            "role": "assistant",
                            "content": "",
                            "tool_calls": [
                                {
                                    "id": "call_1",
                                    "type": "function",
                                    "function": {
                                        "name": "read_file",
                                        "arguments": json.dumps({"path": "test.txt"}),
                                    },
                                }
                            ],
                        }
                    }
                ]
            }
        ),
        FakeResponse(
            json_data={
                "choices": [
                    {
                        "message": {
                            "role": "assistant",
                            "content": "",
                            "tool_calls": [
                                {
                                    "id": "call_2",
                                    "type": "function",
                                    "function": {
                                        "name": "list_directory",
                                        "arguments": json.dumps({"path": "."}),
                                    },
                                }
                            ],
                        }
                    }
                ]
            }
        ),
        FakeResponse(
            json_data={
                "choices": [
                    {
                        "message": {
                            "role": "assistant",
                            "content": "我先读取了文件，再列出了目录。",
                        }
                    }
                ]
            }
        ),
    ]

    monkeypatch.setattr(
        agent.httpx,
        "AsyncClient",
        lambda *args, **kwargs: FakeAsyncClient(responses, calls),
    )
    monkeypatch.setattr(agent, "DEEPSEEK_API_KEY", "test-key")
    monkeypatch.setattr(agent, "DEEPSEEK_MODEL", "test-model")
    monkeypatch.setattr(agent, "DEEPSEEK_API_BASE", "https://example.com/v1")
    monkeypatch.setattr(
        agent,
        "available_tools",
        [
            {
                "name": "read_file",
                "description": "Read a file from the workspace",
                "inputSchema": {
                    "type": "object",
                    "properties": {"path": {"type": "string"}},
                    "required": ["path"],
                },
            },
            {
                "name": "list_directory",
                "description": "List directory contents",
                "inputSchema": {
                    "type": "object",
                    "properties": {"path": {"type": "string"}},
                    "required": ["path"],
                },
            },
        ],
    )

    async def fake_mcp_call_tool(tool_name, arguments):
        if tool_name == "read_file":
            assert arguments == {"path": "test.txt"}
            return {"content": [{"type": "text", "text": "Hello from xihe workspace"}]}

        assert tool_name == "list_directory"
        assert arguments == {"path": "."}
        return {"content": [{"type": "text", "text": "test.txt\nsrc/"}]}

    monkeypatch.setattr(agent, "mcp_call_tool", fake_mcp_call_tool)

    response = await agent.deepseek_response("先读取文件再列目录", "session-3")
    body = await collect_streaming_response(response)

    assert body.count("event: tool_exec_started") == 2
    assert body.count("event: tool_exec_done") == 2
    assert "我先读取了文件，再列出了目录。" in body
    assert len(calls) == 3
    assert any(
        message.get("role") == "tool"
        and "Hello from xihe workspace" in message.get("content", "")
        for message in calls[1]["json"]["messages"]
    )
    assert any(
        message.get("role") == "tool" and "test.txt\nsrc/" in message.get("content", "")
        for message in calls[2]["json"]["messages"]
    )
