{
    "name": "xihe-ui",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite --mode dev",
        "build": "vue-tsc -b && vite build",
        "typecheck": "vue-tsc --noEmit",
        "typecheck:e2e": "node scripts/typecheck-e2e.mjs",
        "lint": "oxfmt --check . && oxlint .",
        "lint:oxlint": "oxlint .",
        "lint:oxfmt": "oxfmt --check .",
        "preview": "vite preview",
        "test:unit": "vitest run",
        "test:e2e": "playwright test --config e2e/playwright.config.ts",
        "test:e2e:fixtures": "node --test \"e2e/fixtures/__tests__/*.test.mjs\""
    },
    "dependencies": {
        "@iconify/vue": "^5.0.1",
        "@lucide/vue": "^1.34.0",
        "@microsoft/fetch-event-source": "^2.0.1",
        "@tailwindcss/vite": "^4.3.3",
        "@vueuse/core": "^15.0.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "dexie": "^4.4.6",
        "dompurify": "^3.4.14",
        "highlight.js": "^11.12.0",
        "katex": "^0.18.4",
        "markstream-vue": "2.0.11",
        "pdfjs-dist": "^6.3.289",
        "pinia": "^4.1.0",
        "pinia-plugin-persistedstate": "^4.7.1",
        "rehype": "^13.0.2",
        "rehype-highlight": "^7.0.2",
        "rehype-katex": "^7.0.1",
        "reka-ui": "^2.11.0",
        "remark": "^15.0.1",
        "remark-gfm": "^4.0.1",
        "remark-math": "^6.0.0",
        "shiki": "^4.4.3",
        "tailwind-merge": "^3.7.0",
        "tailwind-variants": "^3.3.1",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
        "vue": "^3.5.44",
        "vue-i18n": "^11.4.12",
        "vue-router": "^5.3.1",
        "vue-sonner": "^2.0.9"
    },
    "devDependencies": {
        "@playwright/test": "^1.64.1",
        "@types/node": "^26.6.2",
        "@vitejs/plugin-vue": "^6.0.9",
        "@vue/test-utils": "^2.5.1",
        "jsdom": "^30.0.1",
        "monaco-editor": "^0.56.0",
        "msw": "^2.15.0",
        "oxfmt": "0.68.0",
        "oxlint": "1.83.0",
        "oxlint-tsgolint": "7.0.2002",
        "typescript": "~6.0.3",
        "vite": "^8.3.5",
        "vite-plugin-pwa": "^1.3.0",
        "vitest": "^4.1.11",
        "vue-tsc": "^3.3.13"
    }
