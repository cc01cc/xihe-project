# ============================================================
# XH prod 环境基线（入库；密钥类键一律不落文件）
# 真实密钥由部署平台注入（OS env / K8s Secret / CI），fail-fast 校验会
# 在 XIHE_ENV=prod 且命中出厂态危险默认时拒绝启动
# 禁止 `.env.prod.local`：生产配置只来自本文件或部署注入
# ============================================================

# ── 端点（按实际部署调整；默认回环不对外） ──
XIHE_CP_PORT=12631
XIHE_AGENT_HOST=127.0.0.1
XIHE_RUNTIME_HOST=127.0.0.1
XIHE_CP_H2_CONSOLE=false

# ── 数据库（连接串可入库，密码不落） ──
# XIHE_CP_DATASOURCE_URL=jdbc:postgresql://<prod-db>:5432/xihe
# XIHE_PG_DSN=postgresql+psycopg://xihe:@<prod-db>:5432/xihe
# XIHE_CP_DATASOURCE_PASSWORD=        # 部署注入（必填）

# ── 安全：生产强制严格 ──
XIHE_CP_OAUTH_ALLOW_DEV_KEY=false
XIHE_CP_PROVIDER_CREDENTIALS_ALLOW_DEV_KEY=false
XIHE_REMOTE_MCP_ALLOW_INSECURE_LOCAL=false
# XIHE_CP_JWT_SECRET=                 # 部署注入（必填；fail-fast 校验）
# XIHE_CP_API_TOKEN=                  # 部署注入（必填；fail-fast 校验）
# XIHE_AGENT_API_TOKEN=               # 部署注入（必填；fail-fast 校验）
# XIHE_CP_OAUTH_ENCRYPTION_KEY=       # 部署注入（必填；base64 AES-256）
# XIHE_CP_PROVIDER_CREDENTIALS_KEY=   # 部署注入（必填；base64 AES-256）

# ── 日志 ──
XIHE_LOG_LEVEL=info
# XIHE_LOG_DIR=/var/log/xihe
