# =============================================================================
# xihe 环境变量模板
# =============================================================================
# 用法: cp .env.example .env.dev（或 .env.local 等，按需选择环境）
#
# 此文件是所有 .env.* 的唯一模板。禁止创建 .env.dev.example 等冗余文件。
#
# 加载顺序（run-with-log.sh / 各模块 dotenv loader）：
#   1. .env              （base）
#   2. .env.{XIHE_ENV}   （如 .env.dev）
#   3. .env.local         （个人覆盖，gitignore）
#   4. .env.{XIHE_ENV}.local
#
# 应用层配置（LLM provider、API key、embedding 等）通过 CP ConfigService 管理，
# 不在此文件设置。参见 .env.import-template.jsonc 导入模板。
# =============================================================================

XIHE_LOAD_DOTENV=0

# ── 模块端口（1263X 段，详见 one/docs/DOC-XIHE-PORTS.md）──
XIHE_CP_PORT=12631
XIHE_CP_URL=http://localhost:12631
XIHE_CP_BASE_URL=http://localhost:12631

XIHE_AGENT_HOST=0.0.0.0
XIHE_AGENT_PORT=12632
XIHE_AGENT_URL=http://localhost:12632/internal/v1/agent/chat

XIHE_RUNTIME_HOST=0.0.0.0
XIHE_RUNTIME_PORT=12633
XIHE_RUNTIME_URL=http://localhost:12633

XIHE_UI_PORT=12630

XIHE_PG_PORT=12634

# ── 模块间通讯 ──
XIHE_CP_API_TOKEN=dev-token-change-me

# ── Control Plane 数据库 ──
XIHE_CP_DATASOURCE_URL=jdbc:postgresql://localhost:12634/xihe
XIHE_CP_DATASOURCE_DRIVER=org.postgresql.Driver
XIHE_CP_DATASOURCE_USERNAME=xihe
# Dev compose uses trust authentication; set a random 12+ character value when password auth is enabled.
XIHE_CP_DATASOURCE_PASSWORD=
XIHE_CP_JPA_DIALECT=org.hibernate.dialect.PostgreSQLDialect
XIHE_CP_H2_CONSOLE=false

# ── Control Plane 安全 ──
XIHE_CP_JWT_SECRET=dev-jwt-secret-key-do-not-use-in-production-please-change
XIHE_CP_JWT_ACCESS_VALIDITY=900
XIHE_CP_JWT_REFRESH_VALIDITY=604800

# ── 日志 ──
XIHE_LOG_DIR=logs
# XIHE_LOG_LEVEL=info
# XIHE_LOG_LEVEL_CP=INFO
# XIHE_LOG_LEVEL_AGENT=info
# XIHE_LOG_LEVEL_RUNTIME=info
# XIHE_LOG_LEVEL_UI=info
# XIHE_RUNTIME_LOG_FILTER=
# XIHE_CP_AUDIT_LOG_TO_CONSOLE=true

# ── 测试环境覆盖（XIHE_ENV=test 时）──
# 取消注释以下变量切换到测试模式（端口 +10000 偏移，mock LLM）：
# XIHE_LLM_PROVIDER=mock
# XIHE_LOG_LEVEL=info
# XIHE_PG_PORT=22634
# XIHE_CP_PORT=22631
# XIHE_AGENT_PORT=22632
# XIHE_RUNTIME_PORT=22633
# XIHE_UI_PORT=22630
# XIHE_CP_URL=http://127.0.0.1:22631
# XIHE_CP_BASE_URL=http://127.0.0.1:22631
# XIHE_AGENT_HOST=127.0.0.1
# XIHE_RUNTIME_HOST=127.0.0.1
