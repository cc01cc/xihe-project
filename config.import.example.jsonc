{
  // =========================================================================
  // xihe 配置导入模板 — instance 层（PLAN-0307 域模型；approval-policy 的 instance 语义
  // 由 PLAN-0364 决策 #9 恢复：instance 可写默认，workspace 可覆盖）
  // =========================================================================
  // 用法:
  //   PowerShell: Copy-Item config.import.example.jsonc config.import.local.jsonc
  //   Git Bash:   cp config.import.example.jsonc config.import.local.jsonc
  //   curl -X POST "/api/v1/config/import?layer=instance" \
  //     -H "Authorization: Bearer $ADMIN_TOKEN" \
  //     -H "Content-Type: application/json" \
  //     --data-binary @config.import.local.jsonc
  //
  // 凭证（apiKey）不在此文件：provider 凭证存于 provider_connections（UI/API 管理），
  // Agent 运行期经短时租约获取；离线开发可用 env（XIHE_<PROVIDER>_API_KEY）兜底。
  // 仅 config-schemas/ 中声明的键可导入，未知键会导致整个 import 400。
  // config.import.local.jsonc 被 gitignore，不会提交。

  // llm-provider — 模型/端点/默认选择（凭证见 provider_connections）
  "llm-provider": {
    "defaultProvider": "deepseek",
    "defaultModel": "deepseek-v4-flash",
    "deepseekModel": "deepseek-v4-flash",
    "deepseekApiBase": "https://api.deepseek.com/v1",
    "openaiModel": "gpt-4o",
    "openaiApiBase": "https://api.openai.com/v1",
    "xiaomiModel": "mimo-v2.5",
    "xiaomiApiBase": "https://api.xiaomimimo.com/v1",
    "imageProvider": ""
  },

  // context-policy — 上下文压缩策略（defaults/models 结构见 schema）
  // PLAN-0341 T1.6：prune/压缩键可配置。maxInputTokens = 模型总窗；
  // pruneWindowChars = 旧工具输出保留窗（窗口外才裁剪，与模型总窗独立）。
  // 大窗模型（256K/1M）可上调 pruneWindowChars 与 maxInputTokens。
  "context-policy": {
    "defaults": {
      "softThresholdPct": 0.70,
      "hardThresholdPct": 0.90,
      "keepRecentMessages": 10,
      "maxInputTokens": 131072,
      "pruneWindowChars": 80000,
      "recoveryBand": 0.8
    },
    "models": {
      // 示例：按模型覆盖
      // "deepseek-v4-flash": { "maxInputTokens": 131072, "pruneWindowChars": 80000 },
      // "gpt-4o": { "maxInputTokens": 128000 },
      // "claude-sonnet-4": { "maxInputTokens": 200000, "pruneWindowChars": 120000 }
    }
  },

  // approval-policy — 审批模式：**instance 层可写默认（平台管理员），workspace 可覆盖**，
  // user 层不可写（显式例外）。缺省即 `manual`（fail-closed）。
  // "approval-policy": { "mode": "manual" },

  // embedding — 检索嵌入
  "embedding": {
    "model": "text-embedding-3-small",
    "dimensions": 1536
  },

  // rag — 检索增强
  "rag": {
    "chunkSize": 1000,
    "chunkOverlap": 200,
    "topK": 5,
    "minScore": 0.0
  },

  // agent-runtime — Agent 实例级行为（instructions 仅 instance 层可写）
  "agent-runtime": {
    "instructions": "你是 xihe Agent，一个通用的 AI 助手。请用中文回答。你可以使用各种工具来帮助用户完成任务。",
    "useRegistry": "false",
    "useSupervisor": "false",
    // PLAN-0308：系统工具（文件/命令等）的执行预算（秒）。CP 据此计算并进行下发；
    // T3.1（2026-09-13）：预算上限 30 秒（per-call 与数据库配置同顶）；
    // 超过 30 秒的同步等待请改走异步 job（后台进程 + 轮询），不要调大预算。
    "systemToolTimeoutS": "30",
    // PLAN-0308（决策 #31②）：单次工具返回的字节上限。调用方（模型）只能往小调；
    // 超出部分会被截断并标注 "[truncated to N bytes]"（当前无 artifact 留存，截断即丢）。
    "toolOutputLimitBytes": "4096"
  },

  // agent-profile — 用户展示名（instance 默认，user 可覆盖）
  "agent-profile": {
    "userName": "开发者"
  },

  // user-preference — 界面偏好
  "user-preference": {
    "theme": "system",
    "language": "zh-CN"
  },

  // logging — 五级日志（运行期以 DB 为权威，env 仅启动引导）
  "logging": {
    "logLevel": "debug",
    "levelAgent": "debug",
    "levelCp": "debug",
    "levelRuntime": "debug",
    "levelUi": "debug"
  }
}
